# Cypher configuration — copy to .env and fill what you have. All optional.

# AI backend. auto = use the API key if set, else the Claude CLI, else off.
# cli = run on your Claude Code subscription via the `claude` CLI (no API credits).
CYPHER_LLM=auto

# Paid-API orchestration (Claude plans the run and writes the summary). With no
# backend at all, Cypher falls back to a deterministic plan + templated summary.
ANTHROPIC_API_KEY=
CYPHER_MODEL=claude-sonnet-5

# Optional per-module API keys. Each gates exactly one module.
HIBP_API_KEY=          # breach_check (haveibeenpwned.com/API/Key)
IPINFO_TOKEN=          # ip_info (raises rate limits)
GITHUB_TOKEN=          # github_recon (raises API rate limits)
SHODAN_API_KEY=        # shodan_host (account.shodan.io)
DISCORD_BOT_TOKEN=     # discord_id (a bot token; the bot can be offline)

# Behavior tuning
CYPHER_USER_AGENT=cypher-osint/0.1 (+authorized-recon)
CYPHER_TIMEOUT=15
CYPHER_RATE_LIMIT=1.0
CYPHER_PASSIVE_ONLY=false
CYPHER_OUTPUT_DIR=reports

# Optional: path to an Obsidian vault. Reports also get written here as notes.
# Windows example: C:\Users\you\ObsidianVault
# Kali example:    /home/vio/ObsidianVault
CYPHER_VAULT=
