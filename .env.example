# Cypher configuration — copy to .env and fill what you have. All optional.

# Enables AI orchestration (Claude plans the run and writes the summary).
# Without it, Cypher uses a deterministic plan + templated summary.
ANTHROPIC_API_KEY=
CYPHER_MODEL=claude-sonnet-5

# Optional per-module API keys. Each gates exactly one module.
HIBP_API_KEY=          # breach_check (haveibeenpwned.com/API/Key)
IPINFO_TOKEN=          # ip_info (raises rate limits)
GITHUB_TOKEN=          # github_recon (raises API rate limits)

# Behavior tuning
CYPHER_USER_AGENT=cypher-osint/0.1 (+authorized-recon)
CYPHER_TIMEOUT=15
CYPHER_RATE_LIMIT=1.0
CYPHER_PASSIVE_ONLY=false
CYPHER_OUTPUT_DIR=reports
